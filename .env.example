# Postgres (в Railway — ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://user:password@localhost:5432/storage_aggregator

# 2GIS Places API (Каталог 3.0) — https://docs.2gis.com/ru/api/search/places/overview
DGIS_API_KEY=

# Claude API — для краулера сайтов операторов (storage-parser/crawler/site_crawler.py)
ANTHROPIC_API_KEY=

# Порог населения города для выборки из cities.csv
MIN_POPULATION=100000

# Радиус поиска вокруг центра города, метры
DGIS_RADIUS_M=15000

# Задержка между запросами к 2ГИС, секунды (вежливый rate-limit)
DGIS_REQUEST_DELAY_S=0.3
