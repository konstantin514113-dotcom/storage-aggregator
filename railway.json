{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r storage-parser/requirements.txt"
  },
  "deploy": {
    "startCommand": "python server.py",
    "healthcheckPath": "/kubometr.html",
    "restartPolicyType": "ON_FAILURE"
  }
}
